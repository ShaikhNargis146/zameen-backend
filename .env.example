NODE_ENV=development
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB=zameens
DB_USER=postgres
DB_PASSWORD=change-me
# Preferred for Cloud SQL, Cloud SQL Auth Proxy, or managed PostgreSQL.
# When set, DATABASE_URL takes precedence over the DB_HOST/DB_PORT/DB/DB_USER/
# DB_PASSWORD values above.
# DATABASE_URL=postgresql://user:password@host:5432/zameens
# Optional: DB_SSL=true
# Development-only fallback for a direct Cloud SQL connection whose certificate
# is not in the local Node trust store. Keep certificate verification enabled
# in staging and production.
# Optional: DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication — generate unique values for every environment.
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_PEPPER=replace-with-a-different-long-random-secret
# Optional: ACCESS_TOKEN_TTL_SECONDS=900
# Optional: REFRESH_TOKEN_TTL_DAYS=30
# Optional: OTP_TTL_SECONDS=300
# Optional: OTP_MAX_ATTEMPTS=5
# Optional: OTP_RESEND_AFTER_SECONDS=30
# Optional: OTP_RATE_LIMIT_PER_IP_10MIN=20
# OTP delivery
# Local development: generated OTPs are written to the API server log.
# Never use `console` in production.
OTP_DELIVERY_MODE=console
# Staging/production: change OTP_DELIVERY_MODE to `webhook` and set this URL.
# OTP_PROVIDER_WEBHOOK_URL=https://your-otp-provider.example/send

# AI (OpenAI Responses API)
# Required to use /ai/search, AI chat and /ai/listing/generate. The API returns
# AI_PROVIDER_UNCONFIGURED until this server-side secret is configured.
# OPENAI_API_KEY=sk-...
# Optional: OPENAI_MODEL=gpt-5-mini
# Optional: OPENAI_TIMEOUT_MS=15000

# File storage (Google Cloud Storage)
# Required only when requesting upload URLs. The configured identity must be
# allowed to sign URLs and write objects to this bucket.
# GCS_BUCKET=your-private-upload-bucket
# Local development: point this to a service-account JSON file. On GCP, use
# the VM/Cloud Run service account instead and grant it the same permissions.
# GOOGLE_APPLICATION_CREDENTIALS=secrets/gcs-service-account.json
# Optional when it cannot be inferred from the credentials or runtime.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Comma-separated browser origins. Use real HTTPS origins in production.
# Optional: CORS_ORIGINS=http://localhost:3000,http://localhost:5173
