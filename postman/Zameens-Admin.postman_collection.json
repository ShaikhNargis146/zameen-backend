            "url": "{{baseUrl}}/admin/channel-partners/{{partnerId}}/reject"
          }
        },
        {
          "name": "Admin: Suspend channel partner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Compliance issue flagged.\"\n}"
            },
            "url": "{{baseUrl}}/admin/channel-partners/{{partnerId}}/suspend"
          }
        }
      ]
    },
