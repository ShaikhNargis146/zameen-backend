{
  "info": {
    "name": "Zameens \u2014 Admin APIs",
    "description": "Consolidated collection of every admin-only endpoint (Backend Dev 1 + Backend Dev 2 domains) per the Phase 1 API Contract and UI Integration Specification. All requests require an ADMIN-role bearer token set as {{adminAccessToken}}. All responses use the standard { success, data, meta } / { success, error } envelope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "description": "Bearer token for a user with the ADMIN role. Obtain via /auth/otp/verify with an admin account — but there's no self-service path to become one first (users.validation.js#selfRole explicitly blocks self-assigning ADMIN, same as CHANNEL_PARTNER). The account must already have the role granted directly in the DB: INSERT INTO auth.user_roles (user_id, role_id) SELECT '<user id>', id FROM auth.roles WHERE code = 'ADMIN'. Roles are re-resolved fresh from the DB on every /auth/refresh too, not just /auth/otp/verify, so refreshing an existing session also picks up a role granted after the fact — no full re-login required."
    },
    {
      "key": "adId",
      "value": ""
    },
    {
      "key": "auctionId",
      "value": ""
    },
    {
      "key": "contentId",
      "value": ""
    },
    {
      "key": "listingId",
      "value": ""
    },
    {
      "key": "locationId",
      "value": ""
    },
    {
      "key": "mediaId",
      "value": "",
      "description": "id of a photo on the listing's property, from the media array in the Admin — listing detail response."
    },
    {
      "key": "opportunityId",
      "value": ""
    },
    {
      "key": "organizationId",
      "value": ""
    },
    {
      "key": "memberUserId",
      "value": "",
      "description": "id of a user who is (or was) a member of {{organizationId}}, for Admin — update member status."
    },
    {
      "key": "partnerId",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "pointId",
      "value": ""
    },
    {
      "key": "propertyTypeId",
      "value": ""
    },
    {
      "key": "seriesId",
      "value": ""
    },
    {
      "key": "serviceRequestId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "verificationId",
      "value": ""
    },
    {
      "key": "challengeId",
      "value": ""
    },
    {
      "key": "otp",
      "value": "",
      "description": "OTP code from the delivery provider (logged to console in non-production)."
    },
    {
      "key": "adminRefreshToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminAccessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request OTP (admin phone)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"9876511111\",\n  \"countryCode\": \"+91\",\n  \"channel\": \"SMS\",\n  \"purpose\": \"LOGIN\"\n}"
            },
            "url": "{{baseUrl}}/auth/otp/request"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) {",
                  "  pm.collectionVariables.set(\"challengeId\", json.data.challengeId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"otp\": \"{{otp}}\",\n  \"deviceId\": \"admin-postman\",\n  \"deviceName\": \"Postman Admin Collection\"\n}"
            },
            "url": "{{baseUrl}}/auth/otp/verify"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) {",
                  "  pm.collectionVariables.set(\"adminAccessToken\", json.data.accessToken);",
                  "  pm.collectionVariables.set(\"adminRefreshToken\", json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\",\n  \"deviceId\": \"admin-postman\",\n  \"deviceName\": \"Postman Admin Collection\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) {",
                  "  pm.collectionVariables.set(\"adminAccessToken\", json.data.accessToken);",
                  "  pm.collectionVariables.set(\"adminRefreshToken\", json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Logout all sessions",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout-all"
          }
        }
      ]
    },
